# ═══════════════════════════════════════════════════════════════
# NEXUS TAX INTELLIGENCE — Environment Variables
# Copie este arquivo para .env.local e preencha os valores
# ═══════════════════════════════════════════════════════════════

# ─── MODO MOCK (padrão local) ─────────────────────────────────
# true = pipeline simulado, sem chamadas externas, sem custo
# false = pipeline real (requer Supabase + LLM key)
NEXT_PUBLIC_USE_MOCK_PIPELINE=true

# ─── Ambiente ─────────────────────────────────────────────────
APP_ENV=local
LOG_LEVEL=debug

# ─── Supabase (necessário para modo real) ─────────────────────
# Obtenha em: supabase.com → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Apenas server-side — NUNCA prefixe com NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_DB_URL=postgresql://postgres.xxx:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# ─── LLM (necessário quando USE_MOCK_PIPELINE=false) ──────────
# Obtenha em: console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-api03-...
# Alternativa:
# OPENAI_API_KEY=sk-...

# ── AUTH (NextAuth) ────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-secret-key-min-32-chars
NEXTAUTH_URL=https://your-domain.vercel.app

# ── STRIPE ────────────────────────────────────────────────────
# Obtenha em: dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...

# Crie o preco em: dashboard.stripe.com/products
# R$ 97,00 recorrente mensal em BRL
STRIPE_PRICE_ID=price_...

# Webhook secret: dashboard.stripe.com/webhooks
# Endpoint: https://seu-dominio.vercel.app/api/stripe/webhook
# Eventos: checkout.session.completed, customer.subscription.updated,
#           customer.subscription.deleted, invoice.payment_failed
STRIPE_WEBHOOK_SECRET=whsec_...

# ── USUARIOS INICIAIS ──────────────────────────────────────────
# Deixe vazio no inicio — sera preenchido automaticamente
# conforme usuarios se cadastram
AXIOM_USERS_DATA=

# ── PLANOS STRIPE (3 precos) ─────────────────────────────────
# Crie 3 precos no Stripe Dashboard para o mesmo produto AXIOM:
# Core:         R$ 197/mes recorrente
# Intelligence: R$ 497/mes recorrente
# Operations:   R$ 1.490/mes recorrente
STRIPE_PRICE_CORE=price_core_...
STRIPE_PRICE_INTELLIGENCE=price_intelligence_...
STRIPE_PRICE_OPERATIONS=price_operations_...

# ── UPSTASH REDIS (banco de dados de usuarios) ────────────────
# Crie gratis em: upstash.com -> Create Database -> REST API
# Necessario para que os usuarios persistam entre requisicoes no Vercel
UPSTASH_REDIS_REST_URL=https://xxxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=AXxxxxxx...

# ── EMAIL VERIFICACAO (Resend) ───────────────────────────────
# Crie conta gratis em: resend.com
# Free tier: 100 emails/dia
RESEND_API_KEY=re_xxxx...

# ── ADMIN (acesso interno da equipe) ─────────────────────────
# Chave secreta para gerenciar usuarios internos via API
# Gere com: openssl rand -hex 32
ADMIN_SECRET=sua-chave-admin-secreta-aqui
